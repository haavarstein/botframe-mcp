FRAME_HOST=127.0.0.1
FRAME_PORT=8090
FRAME_TOKEN=
FRAME_ALERTS_FILE=data/alerts.json
FRAME_STATUS_FILE=data/agent-wall.json
AGENT_SOURCE_TOKENS_FILE=config/agent-tokens.json
# AGENT_EVENTS_TOKEN is the legacy shared secret. It is off unless set, and the
# server refuses to start if it is set together with per-source token hashes.
# AGENT_EVENTS_TOKEN=
AGENT_URGENT_SOURCES=ops,daily,desk,watch
AGENT_QUIET_HOURS=23:00-07:00
AGENT_QUIET_TZ=America/New_York
